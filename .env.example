# Copy to .env (never commit the real file). Only SARVAM_API_KEY is required.

# Sarvam AI: Telugu speech-to-text, text-to-speech and LLM
SARVAM_API_KEY=
VOICE_SPEAKER=kavitha

# Server
PORT=4200
HOST=127.0.0.1

# Optional: Google Gemini for reasoning and screenshot reading (falls back to Sarvam)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: live mandi prices from data.gov.in (Agmarknet)
DATAGOV_API_KEY=

# Optional: real outbound phone calls (Sarvam Samvaad or Plivo)
PHONE_PROVIDER=
PHONE_WHITELIST=
PHONE_WEBHOOK_SECRET=
PUBLIC_URL=https://sahaya.hmgenx.in
